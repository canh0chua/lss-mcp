# Directory mounted as /workspace inside the container.
# Defaults to /tmp/lss-mcp-workspace. Set this to a broad parent directory
# that contains all your projects (e.g. ~/Documents/github.com).
WORKSPACE_PATH=/path/to/your/projects

# Subdirectory within /workspace to restrict file tool access to.
# Set this to the folder name of the project you are currently working on.
# Example: if WORKSPACE_PATH=/home/user/projects and your project is at
#          /home/user/projects/my-app, set WORKSPACE_PROJECT=my-app
# When set, file tools only access files inside /workspace/$WORKSPACE_PROJECT.
# Agents will be told to use native tools for files outside this project.
WORKSPACE_PROJECT=my-project
